{
  "entities": {
    "Brand": {
      "title": "Brand",
      "description": "A brand of raw materials.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The name of the brand." },
        "description": { "type": "string", "description": "A brief description of the brand." }
      },
      "required": ["name"]
    },
    "Category": {
      "title": "Category",
      "description": "A category of raw materials (e.g., Sticker, Bottle).",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The name of the category." },
        "description": { "type": "string", "description": "A brief description of the category." }
      },
      "required": ["name"]
    },
    "Product": {
      "title": "Raw Material",
      "description": "A specific raw material.",
      "type": "object",
      "properties": {
        "brandId": { "type": "string", "description": "The ID of the brand." },
        "categoryId": { "type": "string", "description": "The ID of the category." },
        "name": { "type": "string", "description": "The name of the raw material." },
        "variant": { "type": "string", "description": "The variant or size of the raw material (optional)." },
        "unit": { "type": "string", "description": "The unit of measurement (e.g., pcs, ml)." },
        "stock": { "type": "number", "description": "The current stock quantity." },
        "lowStockThreshold": { "type": "number", "description": "The threshold for low stock alerts." }
      },
      "required": ["brandId", "categoryId", "name", "unit", "stock"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A stock transaction (IN, OUT, or DELIVERY).",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "description": "The ID of the raw material." },
        "type": { "type": "string", "enum": ["IN", "OUT", "DELIVERY"], "description": "The type of transaction." },
        "quantity": { "type": "number", "description": "The quantity involved in the transaction." },
        "date": { "type": "string", "format": "date-time", "description": "The date and time of the transaction." },
        "note": { "type": "string", "description": "An optional note for the transaction." },
        "userId": { "type": "string", "description": "The ID of the user who performed the transaction." }
      },
      "required": ["productId", "type", "quantity", "date", "userId"]
    },
    "User": {
      "title": "User",
      "description": "A user of the inventory system.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "name": { "type": "string", "description": "The user's name." },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "The user's role." }
      },
      "required": ["email", "name", "role"]
    }
  },
  "firestore": {
    "/brands/{brandId}": { "schema": "Brand", "description": "Collection of brands." },
    "/categories/{categoryId}": { "schema": "Category", "description": "Collection of categories." },
    "/products/{productId}": { "schema": "Product", "description": "Collection of raw materials." },
    "/transactions/{transactionId}": { "schema": "Transaction", "description": "Collection of stock transactions." },
    "/users/{userId}": { "schema": "User", "description": "Collection of users." }
  }
}
